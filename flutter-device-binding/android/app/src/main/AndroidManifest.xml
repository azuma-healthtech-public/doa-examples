<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every flow talks to the Device Binding API. The Flutter template only
         adds this to the debug/profile manifests, so declare it for release too. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="azuma doa example"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <!-- usesCleartextTraffic: implicit on API 28+, declared anyway so the
             guarantee is visible and survives a manifest merge from a library.
             allowBackup: the device key never leaves the KeyStore, but the
             secure-storage blob and its keystore-held wrapping key must not be
             carried to other hardware by auto-backup, where it would be
             undecryptable at best. -->
        <!-- launchMode is singleTask, not the template's singleTop: the Health-ID
             callback arrives while the insurer's app is in front, and singleTop only
             reuses this activity when it is already on top. Anything else builds a
             second instance with a fresh Flutter engine and loses the flow that was
             waiting for the callback. taskAffinity stays empty so this activity keeps
             its own task and cannot be adopted by another app's. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${healthIdCallbackHost}"
                    android:path="${healthIdCallbackPath}" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${transferCallbackHost}"
                    android:path="${transferCallbackPath}" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
